# ==========================================
# GREENWAVE CONFIGURATION ENVIRONMENT
# ==========================================

# Vision / YOLO Settings
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=auto  # mps, cuda, or cpu
YOLO_VEHICLE_CLASSES=2,3,5,7  # 2: car, 3: motorcycle, 5: bus, 7: truck (COCO class IDs)

# SUMO Simulation Settings
SUMO_HOME=auto
SUMO_GUI=false
SUMO_STEP_LENGTH=1.0
SIMULATION_DURATION=3600

# Reinforcement Learning Settings
RL_ALPHA=0.1
RL_GAMMA=0.95
RL_EPSILON=1.0
RL_EPSILON_DECAY=0.995
RL_EPSILON_MIN=0.01
RL_MIN_GREEN=10
RL_MAX_GREEN=60
RL_YELLOW_TIME=4

# Server / API Settings
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///data/results/greenwave.db
DEBUG=false
